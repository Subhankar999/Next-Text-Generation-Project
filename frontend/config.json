{
  "app": {
    "title": "LSTM Text Generator",
    "icon": "🧠",
    "subtitle": "Predict the next word or generate a whole sentence with a PyTorch LSTM.",
    "layout": "centered",
    "footer": "Built with Streamlit · FastAPI · PyTorch"
  },
  "examples": [
    "happiness is found in",
    "life is what happens",
    "the best way to",
    "everything happens for"
  ],
  "input": {
    "label": "Starting sentence",
    "placeholder": "e.g. happiness is found in",
    "height": 120,
    "max_chars": 300
  },
  "slider": {
    "label": "Number of words to generate",
    "min": 1,
    "max": 100,
    "default": 10,
    "step": 1
  },
  "buttons": {
    "word": " Predict Next Word",
    "sentence": " Generate Sentence"
  },
  "history": {
    "enabled": true,
    "max_items": 5
  },
  "api": {
    "word_endpoint": "/word_predict",
    "sentence_endpoint": "/sentense_predict",
    "timeout_seconds": 90,
    "retries": 1
  },
  "messages": {
    "empty_input": "Please enter a starting sentence first.",
    "loading_word": "Predicting the next word…",
    "loading_sentence": "Generating your sentence… (the first request may take ~1 minute while the server wakes up)",
    "timeout_error": "The server took too long to respond. It may be waking up – please try again in a moment.",
    "connection_error": "Cannot reach the backend. Check the API_URL secret and that the server is running.",
    "no_known_words": "None of those words are in the model's vocabulary. Try different words."
  },
  "features": {
    "clear_button": true,
    "add_word_button": true,
    "continue_button": true,
    "download_button": true,
    "show_response_time": true,
    "history_reuse": true,
    "theme_switcher": true
  },
  "default_theme": "Midnight Dark",
  "themes": {
    " Sunset Light": {
      "primary": "#E8506E",
      "accent": "#E8710A",
      "bg_start": "#FFF8F0",
      "bg_end": "#FFEFE3",
      "card_background": "#FFFFFF",
      "card_border": "#F6DCCB",
      "text": "#2D2A32",
      "text_muted": "#8A7F87",
      "sidebar_bg": "#FFEFE3",
      "input_bg": "#FFFFFF"
    },
    " Mint Light": {
      "primary": "#0FA37F",
      "accent": "#D97706",
      "bg_start": "#F2FBF7",
      "bg_end": "#E3F6EC",
      "card_background": "#FFFFFF",
      "card_border": "#CDEBDD",
      "text": "#1F2D28",
      "text_muted": "#6F8A80",
      "sidebar_bg": "#E3F6EC",
      "input_bg": "#FFFFFF"
    },
    " Lavender Light": {
      "primary": "#9B5DE5",
      "accent": "#E0409A",
      "bg_start": "#FAF5FF",
      "bg_end": "#F1E6FD",
      "card_background": "#FFFFFF",
      "card_border": "#E5D3F8",
      "text": "#2B2236",
      "text_muted": "#8C7FA0",
      "sidebar_bg": "#F1E6FD",
      "input_bg": "#FFFFFF"
    },
    " Midnight Dark": {
      "primary": "#FF7AA2",
      "accent": "#FFB86B",
      "bg_start": "#14121F",
      "bg_end": "#1E1B2E",
      "card_background": "#262338",
      "card_border": "#3A3656",
      "text": "#F2F0FA",
      "text_muted": "#A29FB8",
      "sidebar_bg": "#1A1829",
      "input_bg": "#262338"
    }
  }
}
